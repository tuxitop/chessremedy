# ChessRemedy environment configuration.
#
# Copy this file to `.env.local` and fill in the values you need.
# Only VITE_-prefixed variables are exposed to the client bundle — never put a
# secret in one.

# Optional: Dropbox sync (Feature 016).
#
# Create a Dropbox app with "Scoped access" / "App folder" access, then copy its
# **App key** here. The app key is a PUBLIC identifier (PKCE is used, so there is
# no client secret). Register the OAuth redirect URI as:
#
#   <your-origin>/settings
#
# Leaving this empty disables sync; the app remains fully usable offline.
VITE_DROPBOX_APP_KEY=
