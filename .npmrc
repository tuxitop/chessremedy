save-exact=false
engine-strict=true
# eslint-plugin-jsx-a11y@6.x (latest) declares a peer range up to eslint ^9,
# while the project uses eslint@10 (latest). This is an upstream lag, not a
# real incompatibility: the pair is installed and `npm run lint` passes.
# Accept the legacy resolution so `npm ci` works identically in CI and locally.
legacy-peer-deps=true
