{
  "name": "chessremedy",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "license": "GPL-3.0-or-later",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:browser": "playwright test",
    "test:browser:serial": "playwright test --workers=1",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc -b --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "fetch-piece-assets": "node scripts/fetch-piece-assets.mjs",
    "copy-stockfish-assets": "node scripts/copy-stockfish-assets.mjs",
    "generate-icons": "node scripts/generate-icons.mjs",
    "postinstall": "node scripts/fetch-piece-assets.mjs && node scripts/copy-stockfish-assets.mjs"
  },
  "dependencies": {
    "@lichess-org/chessground": "^10.1.1",
    "chessops": "^0.15.1",
    "dexie": "^4.0.0",
    "dropbox": "^10.46.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.18.3",
    "recharts": "^3.10.1",
    "stockfish": "^18.0.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.0.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.4.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.0",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.0.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fake-indexeddb": "^6.0.0",
    "globals": "^17.12.0",
    "happy-dom": "^20.14.0",
    "jsdom": "^30.0.0",
    "msw": "^2.15.0",
    "prettier": "^3.0.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.2.2",
    "vite-plugin-pwa": "^1.0.0",
    "vitest": "^5.0.0",
    "workbox-window": "^7.0.0"
  }
}
